CA_URL=https://ca.ice.land:9000
ROOT_FILE=/etc/step/root_ca.crt
PROVISIONER=admin
PROVISIONER_PASSWORD_FILE=/etc/step/provisioner-password
HOST_FQDN=server.ice.land
HOST_SHORT_NAME=server
HOST_PUBLIC_KEY=/etc/ssh/ssh_host_ed25519_key.pub
HOST_CERTIFICATE=/etc/ssh/ssh_host_ed25519_key-cert.pub
SSH_SERVICE=sshd.service
