[Unit]
Description=Caddy TLS proxy for Home Assistant
Wants=homeassistant.service
After=homeassistant.service

[Container]
ContainerName=caddy
Image=docker.io/library/caddy:2.10.2
Network=homeassistant.network
IP=10.89.10.2
PublishPort=80:80
PublishPort=443:443
Volume=/etc/caddy:/etc/caddy:ro,Z
Volume=/var/lib/caddy:/data:Z

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
